{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomad-webpage",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    { "pattern": "nomadbarbershop.hr", "custom_domain": true },
    { "pattern": "www.nomadbarbershop.hr", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "nomad-media" }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nomad-webpage"
    }
  ],
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "817abbd24f32456680abec7d9eea190b" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "cdb01aadc7b8442b800b665aa189abf4" }
  ],
  "vars": {
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "142o1xmd",
    "NEXT_PUBLIC_SANITY_DATASET": "production"
  }
}
